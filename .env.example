# Database — provisioned via Rabbit Deploy → Create Database (Lakebase). Neon
# is no longer provisioned through Rabbit Deploy — bring your own connection
# string if you specifically need Neon.
DATABASE_URL=""

# ─── Authentication ──────────────────────────────────────────────────────────
# Env vars depend on which provider is set up. See .claude/skills/setup-auth.md
#
# GovAuth (WOG AD or TechPass via GovAuth proxy — sandbox/POC only, Better Auth):
# For WOG AD:
# WOGAD_CLIENT_ID=""
# WOGAD_CLIENT_SECRET=""
# For TechPass (alternative — swap WOGAD_* for TECHPASS_*):
# TECHPASS_CLIENT_ID=""
# TECHPASS_CLIENT_SECRET=""
# Both providers share:
# DOMAIN_URI_VIBER=""        # e.g. https://s3037-yourapp.cio.sandbox.gov.sg
# DOMAIN_URI_MAIN=""         # e.g. https://yourapp.cio.sandbox.gov.sg
# BETTER_AUTH_SECRET=""
#
# Direct TechPass (Auth.js v5 — vibe-techpass):
# AUTH_SECRET=""
# TECHPASS_DIRECT_CLIENT_ID=""
# TECHPASS_DIRECT_CLIENT_SECRET=""
# TECHPASS_TENANT_ID=""
#
# Direct WOG AD (Auth.js v5 — vibe-wogad):
# AUTH_SECRET=""
# WOGAD_DIRECT_CLIENT_ID=""
# WOGAD_DIRECT_CLIENT_SECRET=""
# WOGAD_TENANT_ID=""
#
# Entra ID (separate org tenant, Better Auth — vibe-entraid):
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID=""
# DOMAIN_URI_VIBER=""        # e.g. https://s3037-yourapp.cio.sandbox.gov.sg
# DOMAIN_URI_MAIN=""         # e.g. https://yourapp.cio.sandbox.gov.sg
# BETTER_AUTH_SECRET=""

# ─── Email ────────────────────────────────────────────────────────────────────
# Env vars depend on which provider is set up. See .claude/skills/setup-email.md
#
# Postman (default gov email):
# POSTMAN_API_KEY=""
# POSTMAN_FROM_NAME=""       # e.g. Invoice Tracker — optional, defaults to "Postman"
#
# AWS SES:
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_SES_REGION=""
# SES_FROM_EMAIL=""          # e.g. noreply@yourapp.gov.sg
#
# Resend:
# RESEND_API_KEY=""
# RESEND_FROM_ADDRESS=""     # e.g. noreply@yourapp.gov.sg
# RESEND_FROM_NAME=""        # e.g. Invoice Tracker
#
# SMTP (generic — for any SMTP-compatible provider):
# SMTP_HOST=""
# SMTP_PORT=""               # typically 587 (STARTTLS) or 465 (SSL)
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_FROM_ADDRESS=""       # e.g. noreply@yourapp.gov.sg
# SMTP_FROM_NAME=""          # e.g. Invoice Tracker
